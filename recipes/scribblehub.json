{
  "id": "scribblehub",
  "name": "Scribble Hub",
  "domain": "scribblehub.com",
  "version": 3,
  "novelTitleSelector": "div.fic_title, h1",
  "chapterTitleSelector": "div.chapter-title, h1",
  "titleSelector": "h1",
  "chapterContentSelector": "div#chp_raw, div.chp_raw, .chapter-content",
  "chapterListSelector": "ul.toc li a, .toc_w a, .toc_chap a, #chp_list a, a[href*='/read/']",
  "nextChapterSelector": "a.btn-next",
  "prevChapterSelector": "a.btn-prev",
  "authorSelector": "span.auth_name_fic a",
  "coverSelector": "div.fic_image img",
  "descriptionSelector": "div.wi_fic_desc",
  "tagsSelector": ".stag, .wi_fic_tags a",
  "viewportMode": "MOBILE",
  "requiresJavascript": true,
  "chapterListStrategy": "NUMBERED_PAGES",
  "chapterListContinuationSelector": ".pagination, .page-nav, .chp_pagination, .toc_pagination, .toc_p_pg, .toc_paging, .navigation, [class*='pagination'], [class*='paginate']",
  "chapterListEntriesPerPageSelector": ".toc_p_pg select, select.form-control, select",
  "chapterListPageSizeValue": "50",
  "chapterListMaxPages": 100
}
