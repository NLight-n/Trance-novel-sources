{
  "id": "novelupdates",
  "name": "Novel Updates",
  "domain": "novelupdates.com",
  "version": 3,
  "novelTitleSelector": "div.seriestitlenew, h1.seriestitlenew, div.seriestitle, h1",
  "chapterTitleSelector": "h1, .entry-title",
  "titleSelector": "h1",
  "chapterContentSelector": "div#post-content, .entry-content, div.sp-body, #content",
  "chapterListSelector": "table#myTable a[href*='/extnu/'], #myTable tr td a, a.chp-release, table#myTable a, a[href*='/extnu/'], table.tablesorter a, div.sp-body a, a.chapter-link",
  "nextChapterSelector": "a.next, a.nextpostslink",
  "prevChapterSelector": "a.prev, a.prevpostslink",
  "authorSelector": "a#authtag, #authtag, #showauthors a, .author",
  "coverSelector": "div.seriesimg img, .seriesimg img, div.seriesthumb img",
  "descriptionSelector": "div#editdescription, #editdescription",
  "tagsSelector": "div#showtags a, #showtags a, div#showgenre a, #showgenre a, a.genre",
  "viewportMode": "MOBILE",
  "requiresJavascript": true,
  "chapterListStrategy": "NUMBERED_PAGES",
  "chapterListContinuationSelector": ".digg_pagination, #mypager",
  "chapterListMaxPages": 100,
  "accessMarkerSelector": "a[href*='/login/'], a[href*='novelupdates.com/login'], #my_popup, div.my_popup, .login"
}
