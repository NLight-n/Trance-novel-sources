{
  "id": "wuxiaworld",
  "name": "Wuxiaworld",
  "domain": "wuxiaworld.com",
  "version": 2,
  "novelTitleSelector": "h1, h1.font-bold, meta[property='og:title']",
  "chapterTitleSelector": "h2, h1, div[class*='chapter-title']",
  "titleSelector": "h1",
  "chapterContentSelector": "div[prop='articleBody'], div#chapter-content, div.chapter-content, .p-15, div[class*='chapter-content']",
  "chapterListSelector": "li.chapter-item > a, a.chapter-link, a[href*='/chapter-'], a[href*='/novel/'][href*='/chapter'], .list-chapters a, .panel-body a",
  "nextChapterSelector": "a[rel='next'], a.next-chapter",
  "prevChapterSelector": "a[rel='prev'], a.prev-chapter",
  "authorSelector": "div.author, .author-name, span.author, a[href*='/author/']",
  "coverSelector": "img.novel-cover, .cover-image, img[src*='/novel/'], meta[property='og:image'], .novel-body img",
  "descriptionSelector": "div.synopsis, div.description, div[class*='synopsis'], meta[property='og:description']",
  "tagsSelector": "div.tags a, a[href*='/tag/'], a[href*='/genre/'], .genre a",
  "viewportMode": "MOBILE",
  "requiresJavascript": true
}
