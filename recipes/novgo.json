{
  "id": "novgo",
  "name": "NOVGO",
  "domain": "novgo.net",
  "version": 3,
  "novelTitleSelector": ".m-desc h1.tit, .m-info .g-tit .tit, h1.tit",
  "chapterTitleSelector": "h1.chapter .chapter-title, .top h1.chapter, h1.chapter",
  "titleSelector": "h1.tit, h1.chapter",
  "chapterContentSelector": "#chapter-content, div.chapter-c, .txt.fwn-reader-txt",
  "chapterListSelector": "#idData li a.con, #idData li a, #list-chapter #idData a.con",
  "nextChapterSelector": "a[data-nav='next'], li.reader-next-item a",
  "prevChapterSelector": "a[data-nav='prev'], li.prev a:not(.is-disabled)",
  "authorSelector": ".m-imgtxt .item .right a[href*='/author/'], .m-imgtxt a[href*='/author/']",
  "coverSelector": ".m-imgtxt .pic img, .m-imgtxt img",
  "descriptionSelector": "#novel-summary-inner, .m-desc .txt .inner, .m-desc .txt",
  "tagsSelector": ".m-imgtxt .item .right a[href*='/genre/'], .m-imgtxt a[href*='/genre/']",
  "viewportMode": "MOBILE",
  "requiresJavascript": true,
  "chapterListStrategy": "PAGINATION_NEXT",
  "chapterListContinuationSelector": "#barcon a#nextBtn[href], a#nextBtn[href], #barcon",
  "chapterListMaxPages": 100
}
