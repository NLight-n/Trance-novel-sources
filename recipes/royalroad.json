{
  "id": "royalroad",
  "name": "Royal Road",
  "domain": "royalroad.com",
  "version": 2,
  "novelTitleSelector": "div.fic-header h1, h1.font-white, h1",
  "chapterTitleSelector": "h1, h2.font-white",
  "titleSelector": "h1",
  "chapterContentSelector": "div.chapter-inner.chapter-content, div.chapter-inner, .chapter-content",
  "chapterListSelector": "#chapters a[href*='/chapter/'], tr.chapter-row a, tbody tr a[href*='/chapter/']",
  "nextChapterSelector": "a.nav-next, a[rel~='next']",
  "prevChapterSelector": "a.nav-previous, a[rel~='prev']",
  "authorSelector": "h4 a[href*='/profile/'], h4.font-white > span > a, .author-name a",
  "coverSelector": "img.thumbnail, .cover-art-container img, .profile-image img",
  "descriptionSelector": "div.description, div.synopsis",
  "tagsSelector": "span.tags a, .tag, a[href*='/fictions/search?tagsAdd=']",
  "viewportMode": "MOBILE",
  "requiresJavascript": true,
  "chapterListStrategy": "CURRENT_RENDERED_DOM",
  "chapterListMaxPages": 100
}
